    {
      "val_id": "PRIV-02",
      "title": "Account-existence leakage via register vs. login",
      "control": "Duplicate check on register; single error on login",
      "acceptance": "Register leaks existence via 409 (expected, common pattern). Login must return the identical 401 message for both wrong-password and unknown-email cases.",
      "nodeid": "tests/privacy_validation/test_privacy.py::test_priv02_account_existence_leakage",
      "path": "C:\\Users\\ASUS TUF\\Documents\\GitHub\\lablens-ai\\backend\\tests\\privacy_validation\\test_privacy.py",
      "inputs": {
        "registered": "dup@example.com",
        "second_register": "dup@example.com",
        "login_wrong_password": "dup@example.com / Wrong-Passw0rd!",
        "login_unknown_email": "ghost@example.com / Wrong-Passw0rd!"
      },
      "checks": [
        {
          "description": "Second register (case-insensitive): status/detail",
          "expected": "409 Email is already registered",
          "actual": "409 Email is already registered",
          "passed": true
        },
        {
          "description": "Login wrong password: status/detail",
          "expected": "401 Invalid email or password",
          "actual": "401 Invalid email or password",
          "passed": true
        },
        {
          "description": "Login unknown email: status/detail",
          "expected": "401 Invalid email or password",
          "actual": "401 Invalid email or password",
          "passed": true
        },
        {
          "description": "Login bodies byte-identical",
          "expected": "true",
          "actual": "true",
          "passed": true
        },
        {
          "description": "Login WWW-Authenticate headers identical",
          "expected": "Bearer",
          "actual": "Bearer",
          "passed": true
        }
      ],
      "outputs": {
        "wrong password response": "{\"detail\": \"Invalid email or password\"}",
        "unknown email response": "{\"detail\": \"Invalid email or password\"}"
      },
      "notes": [
        "The 409 on registration confirms that an email is registered. The assessment accepts this as a common pattern; it lets an attacker enumerate accounts through /auth/register rather than /auth/login."
      ],
      "images": [],
      "finding": null,
      "weakness": false,
      "outcome": "passed"
    },
