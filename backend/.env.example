APP_ENV=development
OPENAI_API_KEY=your_openai_api_key_here
EXPLANATION_PROVIDER=openai
EXPLANATION_MODEL=gpt-4o-mini
EXPLANATION_RATE_LIMIT=30
MONGODB_URI=mongodb://localhost:27017/lablens
