APP_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here
EXPLANATION_PROVIDER=gemini
EXPLANATION_MODEL=gemini-3.8-flash
EXPLANATION_RATE_LIMIT=30
MONGODB_URI=mongodb://localhost:27017/lablens
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-secret
JWT_EXPIRE_MINUTES=60
DATABASE_NAME=lablens

# Public embedding model; downloaded on first real encoding unless cached.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# true prevents downloads and requires cached model files.
EMBEDDING_LOCAL_FILES_ONLY=false
# Optional Hugging Face model revision; leave blank to use the default revision.
EMBEDDING_MODEL_REVISION=

# Generated static medical KB index; relative paths resolve against backend/.
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=lablens_medical_kb_v1
